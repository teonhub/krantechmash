<IfModule mod_rewrite.c>
    # ----------------------------------------------------------------------
    # 1. Отключаем автоматические слеши
    # ----------------------------------------------------------------------
    DirectorySlash Off
    Options -Indexes

    RewriteEngine On
    RewriteBase /
	AddDefaultCharset UTF-8

    # ----------------------------------------------------------------------
    # 2. Редирект на HTTPS (с учетом OpenResty)
    # ----------------------------------------------------------------------
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# ----------------------------------------------------------------------
    # 3. Редирект с www на без www
    # ----------------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # ----------------------------------------------------------------------
    # 4. Убираем "index.html" из URL
    # ----------------------------------------------------------------------
    # Если пользователь явно набрал .../index.html
    RewriteCond %{THE_REQUEST} ^GET\ /.*/index\.html [NC]
    # Редиректим на уровень выше
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

    # ----------------------------------------------------------------------
    # 5. Убираем слеш в конце (Trailing Slash)
    # ----------------------------------------------------------------------
    # Если адрес заканчивается на слеш (и это не корень сайта)
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # ----------------------------------------------------------------------
    # 6. Внутренняя маршрутизация
    # ----------------------------------------------------------------------
    
    # Если это реальный файл
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Подсовываем серверу index.html из папки
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*)$ $1/index.html [L]

    ErrorDocument 404 /404.html
</IfModule>

# Кэширование
<IfModule mod_headers.c>
    # 1. Гарантируем UTF-8 для HTML
    <FilesMatch "\.(html|htm)$">
        Header always set Content-Type "text/html; charset=utf-8"
    </FilesMatch>

    # 2. Кэширование статических ресурсов
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|png|jpe?g|webp|svg|gif|ico|avif)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # 3. Запрет кэширования для динамических файлов
    <FilesMatch "\.(json|xml|rss)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>